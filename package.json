{
  "name": "@barth/opencode-acp-provider",
  "version": "0.1.0",
  "description": "Expose an ACP (Agent Client Protocol) agent as an OpenCode model provider",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "opencode",
    "opencode-plugin",
    "acp",
    "agent-client-protocol"
  ],
  "files": [
    "index.ts",
    "src",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": "./index.ts",
    "./plugin": "./src/plugin.ts",
    "./provider": "./src/index.ts",
    "./core": "./src/core/types.ts",
    "./core/models": "./src/core/models.ts",
    "./core/prompt": "./src/core/prompt.ts",
    "./core/session-key": "./src/core/session-key.ts",
    "./core/session-pool": "./src/core/session-pool.ts",
    "./acp": "./src/acp/agent.ts",
    "./settings": "./src/settings.ts",
    "./opencode-transport": "./src/adapters/opencode-transport.ts",
    "./opencode-protocol": "./src/adapters/opencode-protocol.ts",
    "./cli": "./src/adapters/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "acp-run": "bun run src/adapters/cli.ts",
    "verify:real": "bun run verify-real.ts",
    "verify:agent": "bun run verify-agent.ts",
    "verify:resume": "bun run verify-resume.ts",
    "verify:sessions": "bun run verify-sessions.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run typecheck && npm run verify:package"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@opencode/ai": "~2.0.22",
    "@opencode/plugin": "~2.0.22",
    "@opencode/schema": "~2.0.22",
    "effect": "4.0.0-rc.112",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "24.10.1",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
