{
  "name": "opencode-acp-provider",
  "version": "0.1.0",
  "description": "Expose un agent ACP (Agent Client Protocol) comme model provider OpenCode",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "src",
    "bin"
  ],
  "bin": {
    "acp-run": "./bin/acp-run.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts",
    "./core": "./src/core/types.ts",
    "./core/models": "./src/core/models.ts",
    "./core/prompt": "./src/core/prompt.ts",
    "./acp": "./src/acp/agent.ts",
    "./settings": "./src/settings.ts",
    "./opencode-transport": "./src/adapters/opencode-transport.ts",
    "./opencode-protocol": "./src/adapters/opencode-protocol.ts",
    "./cli": "./src/adapters/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "acp-run": "bun run src/adapters/cli.ts",
    "verify:real": "bun run verify-real.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run typecheck && npm run verify:package"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@opencode/ai": "2.0.16",
    "@opencode/schema": "2.0.16",
    "effect": "4.0.0-rc.112",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.16",
    "@types/bun": "1.4.0",
    "@types/node": "24.10.1",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=20"
  }
}
