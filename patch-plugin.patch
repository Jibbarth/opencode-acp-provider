+/**
+ * Names the `/connect` entry after the agent it holds.
+ *
+ * Note: this is the only lever on how a connection is labelled. OpenCode names
+ * a credential after its **integration** - measured, not documented: the key
+ * field does not reach the label - and the integration API exposes nothing to
+ * name a credential. Renaming the integration is therefore how the account in
+ * the user's connection list ends up saying `copilot` rather than `ACP`.
+ *
+ * Note: `ACP` again once disconnected, so the entry stays recognisable in
+ * `/connect` when there is nothing to connect.
+ */
+const nameConnect = async (ctx: Context, name: string): Promise<void> => {
+  try {
+    let renamed = false
+    await ctx.integration.transform((editor: IntegrationEditor) => {
+      if (editor.get(CONNECT_INTEGRATION_ID)?.name === name) return
+      editor.update(CONNECT_INTEGRATION_ID, (integration) => {
+        integration.name = name
+      })
+      renamed = true
+    })
+    if (renamed) await ctx.integration.reload()
+  } catch (error) {
+    log(`intégration /connect non renommée : ${reason(error)}`)
+  }
+}
